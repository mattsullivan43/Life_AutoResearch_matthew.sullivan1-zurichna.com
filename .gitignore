# ─── secrets (NEVER commit) ───────────────────────────────────────────────
.env
.env.*
# the template carries NO secrets and must be committed (gitignore has no trailing comments)
!.env.example
*.key
*.pem
*credential*
*secret*

# ─── python ───────────────────────────────────────────────────────────────
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# ─── node / frontend build ────────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/node_modules/

# ─── runs/ : persistent memory + experiment lab ───────────────────────────
# Keep the folder, ignore generated artifacts. runs/lab holds nested git repos
# (the keep/discard chain) — must never be committed into the parent repo.
runs/lab/
runs/*.jsonl
runs/*.txt
# results_<channel>.tsv (the notebook) AND solution_<channel>.json (the banked
# best prompts) ARE tracked on purpose — they are the demo's memory and a fresh
# deploy must warm-start from them.
!runs/.gitkeep

# ─── broker submissions: RAW emails contain real PII — never commit. The
# extracted/ and classified/ JSONs are ANONYMISED and are tracked so a fresh
# deploy (Render builds from git) carries the demo data. ─────────────────
data/submissions/*.eml
data/submissions/*.msg

# ─── os / editor ──────────────────────────────────────────────────────────
.DS_Store
*.swp
.idea/
.vscode/
