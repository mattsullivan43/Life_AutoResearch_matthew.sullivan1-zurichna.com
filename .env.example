# Copy to .env and fill in. .env is gitignored and never baked into the Docker
# image (.dockerignore) — it is passed to the container at runtime via --env-file.
# Real environment variables always win over this file (override=False).

# ── LLM provider: set ONE of these ────────────────────────────────────────
# OpenAI  → classifier gpt-4o-mini, optimizer gpt-4o
OPENAI_API_KEY=sk-proj-...
# Anthropic → classifier claude-haiku-4-5-20251001, optimizer claude-sonnet-4-6
# ANTHROPIC_API_KEY=sk-ant-...

# ── Optional: auth gate (omit all three for open local dev) ───────────────
# COGNITO_REGION=us-east-1
# COGNITO_POOL_ID=us-east-1_xxxxxxxxx
# COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# Fallback if Cognito is not configured: HTTP basic auth
# APP_USER=zurich
# APP_PASSWORD=
